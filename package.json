{
  "name": "athena",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "check": "turbo run lint typecheck test",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "3.3.3",
    "turbo": "2.11.10",
    "typescript": "5.6.3"
  },
  "pnpm": {
    "overrides": {
      "fastify": ">=5.12.5",
      "yaml": ">=2.8.3",
      "vite@<6.4.4": ">=6.4.4"
    }
  }
}