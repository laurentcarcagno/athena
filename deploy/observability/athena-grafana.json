{
  "title": "Athena : API et synchronisation",
  "uid": "athena-api",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": { "list": [{ "name": "datasource", "type": "datasource", "query": "prometheus" }] },
  "panels": [
    { "id": 1, "type": "timeseries", "title": "Débit par route (req/s)", "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": "${datasource}", "targets": [{ "expr": "sum by (route) (rate(athena_http_requests_total[5m]))", "legendFormat": "{{route}}" }] },
    { "id": 2, "type": "timeseries", "title": "Erreurs 5xx (part des requêtes)", "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": "${datasource}", "targets": [{ "expr": "sum(rate(athena_http_requests_total{status=\"5xx\"}[5m])) / clamp_min(sum(rate(athena_http_requests_total[5m])), 1)", "legendFormat": "5xx" }],
      "fieldConfig": { "defaults": { "unit": "percentunit" } } },
    { "id": 3, "type": "timeseries", "title": "Latence p50 et p95 (s)", "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": "${datasource}", "targets": [
        { "expr": "histogram_quantile(0.5, sum by (le) (rate(athena_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(athena_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p95" }],
      "fieldConfig": { "defaults": { "unit": "s" } } },
    { "id": 4, "type": "stat", "title": "Retard de synchronisation (s)", "gridPos": { "x": 12, "y": 8, "w": 6, "h": 4 },
      "datasource": "${datasource}", "targets": [{ "expr": "max(athena_outbox_oldest_age_seconds)" }],
      "fieldConfig": { "defaults": { "unit": "s", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 60 }, { "color": "red", "value": 300 }] } } } },
    { "id": 5, "type": "stat", "title": "Événements non publiés", "gridPos": { "x": 18, "y": 8, "w": 6, "h": 4 },
      "datasource": "${datasource}", "targets": [{ "expr": "max(athena_outbox_backlog)" }] },
    { "id": 6, "type": "timeseries", "title": "Livraisons de webhooks en attente et en échec", "gridPos": { "x": 12, "y": 12, "w": 12, "h": 4 },
      "datasource": "${datasource}", "targets": [{ "expr": "max by (status) (athena_webhook_deliveries)", "legendFormat": "{{status}}" }] }
  ]
}
