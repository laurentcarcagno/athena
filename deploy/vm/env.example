# Exemple de configuration (valeurs factices). Copier en `.env`, ne jamais commiter le fichier réel.
# Les secrets viennent idéalement d'OpenBao (AppRole : OPENBAO_ROLE_ID et OPENBAO_SECRET_ID) ; à défaut, d'un fichier .env en lecture seule (chmod 600).
ATHENA_VERSION=1.0.0
PUBLIC_URL=https://athena.exemple.lan
WEB_PORT=8080

# Base PostgreSQL (VM dédiée) : compte applicatif sous RLS et compte propriétaire du schéma, distincts.
DATABASE_URL=postgres://athena_app:CHANGE_ME@pg.exemple.lan:5432/athena
MIGRATION_DATABASE_URL=postgres://athena_owner:CHANGE_ME@pg.exemple.lan:5432/athena

# Identité
KEYCLOAK_ISSUER=https://keycloak.exemple.lan/realms/athena
KEYCLOAK_WEB_CLIENT_ID=athena-web
KEYCLOAK_WEB_CLIENT_SECRET=CHANGE_ME_8_CHARS_MIN

# Secrets (OpenBao) : AppRole recommandé en dehors de Kubernetes ; OPENBAO_TOKEN seulement pour un essai.
OPENBAO_ADDR=https://openbao.exemple.lan:8200
OPENBAO_ROLE_ID=
OPENBAO_SECRET_ID=
OPENBAO_TOKEN=

# Historique GitLab et pièces jointes
GITLAB_URL=https://gitlab.exemple.lan
GITLAB_TOKEN=
GITLAB_NAMESPACE=athena-historique
S3_ENDPOINT=https://minio.exemple.lan:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Limitation de débit partagée entre les deux API, et jeton porteur de GET /metrics (16 caractères minimum ; vide : métriques désactivées)
RATE_LIMIT_STORE=postgres
METRICS_TOKEN=
ATHENA_PROTECTION_LEVEL=
