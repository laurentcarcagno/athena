{
  "realm": "athena",
  "enabled": true,
  "displayName": "ATHENA",
  "loginTheme": "athena",
  "registrationAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "sslRequired": "none",
  "roles": {
    "realm": [
      {
        "name": "athena-admin",
        "description": "Administrateur plateforme"
      },
      {
        "name": "athena-pm",
        "description": "Chef de projet"
      },
      {
        "name": "athena-qa",
        "description": "Assurance qualité (droits d'un utilisateur, approbation des jalons et baselines)"
      },
      {
        "name": "athena-manager",
        "description": "Manager : charge de ses équipes (droits d'un membre d'équipe)"
      },
      {
        "name": "athena-pmo",
        "description": "PMO : gestion des portefeuilles, des équipes et des revues de portefeuille (droits d'un membre d'équipe)"
      },
      {
        "name": "athena-finance",
        "description": "Finance : budgets, engagements, réels, prévisions et taux des ressources (aucun autre droit)"
      },
      {
        "name": "athena-director",
        "description": "Directeur : portefeuilles et tableaux de bord, en lecture seule"
      },
      {
        "name": "athena-team-member",
        "description": "Membre d'équipe"
      }
    ]
  },
  "groups": [
    {
      "name": "org-demo"
    }
  ],
  "clients": [
    {
      "clientId": "athena-web",
      "enabled": true,
      "publicClient": false,
      "secret": "dev-only-athena-web-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:3001/auth/callback",
        "http://localhost:3000/*"
      ],
      "webOrigins": [
        "http://localhost:3000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*",
        "backchannel.logout.url": "http://host.docker.internal:3001/auth/backchannel-logout",
        "backchannel.logout.session.required": "false"
      },
      "protocolMappers": [
        {
          "name": "aud-athena-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "athena-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "true",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "athena-worker",
      "enabled": true,
      "publicClient": false,
      "secret": "dev-only-athena-worker-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "protocolMappers": [
        {
          "name": "aud-athena-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "athena-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "true",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "athena-api",
      "enabled": true,
      "bearerOnly": true
    },
    {
      "clientId": "athena-dev-cli",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocolMappers": [
        {
          "name": "aud-athena-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "athena-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "true",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ],
      "attributes": {
        "athena.note": "DEV UNIQUEMENT : permet d'obtenir un jeton en ligne de commande pour les tests."
      }
    }
  ],
  "users": [
