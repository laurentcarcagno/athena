{
  "realm": "athena",
  "enabled": true,
  "displayName": "Athena (dev)",
  "registrationAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "sslRequired": "none",
  "roles": {
    "realm": [
      {
        "name": "athena-admin",
        "description": "Administrateur plateforme"
      },
      {
        "name": "athena-user",
        "description": "Utilisateur"
      }
    ]
  },
  "groups": [
    {
      "name": "org-demo"
    }
  ],
  "clients": [
    {
      "clientId": "athena-web",
      "enabled": true,
      "publicClient": false,
      "secret": "dev-only-athena-web-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/*"
      ],
      "webOrigins": [
        "http://localhost:3000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "aud-athena-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "athena-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "true",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "athena-worker",
      "enabled": true,
      "publicClient": false,
      "secret": "dev-only-athena-worker-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "protocolMappers": [
        {
          "name": "aud-athena-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "athena-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "true",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "athena-api",
      "enabled": true,
      "bearerOnly": true
    },
    {
      "clientId": "athena-dev-cli",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocolMappers": [
        {
          "name": "aud-athena-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "athena-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "true",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ],
      "attributes": {
        "athena.note": "DEV UNIQUEMENT : permet d'obtenir un jeton en ligne de commande pour les tests."
      }
    }
  ],
  "users": [
    {
      "username": "admin.dev",
      "enabled": true,
      "email": "admin.dev@example.test",
      "firstName": "Admin",
      "lastName": "Dev",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "dev-only-admin",
          "temporary": false
        }
      ],
      "realmRoles": [
        "athena-admin",
        "athena-user"
      ],
      "groups": [
        "/org-demo"
      ],
      "requiredActions": [
        "CONFIGURE_TOTP"
      ]
    },
    {
      "username": "user.dev",
      "enabled": true,
      "email": "user.dev@example.test",
      "firstName": "User",
      "lastName": "Dev",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "dev-only-user",
          "temporary": false
        }
      ],
      "realmRoles": [
        "athena-user"
      ],
      "groups": [
        "/org-demo"
      ]
    }
  ]
}