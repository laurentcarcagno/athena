{
  "name": "@athena/api",
  "version": "0.0.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').cpSync('src/db/migrations','dist/db/migrations',{recursive:true});require('fs').copyFileSync('src/plugins/runner.cjs','dist/plugins/runner.cjs')\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "node -e \"console.log('lint api : eslint à configurer')\"",
    "test": "vitest run",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js"
  },
  "dependencies": {
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-fastify": "11.2.8",
    "fastify": "5.12.7",
    "jose": "5.9.3",
    "pg": "8.13.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "yaml": "2.6.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.8",
    "@swc/core": "1.7.36",
    "@types/node": "22.7.5",
    "@types/pg": "8.11.10",
    "unplugin-swc": "1.5.1",
    "vitest": "4.1.12"
  }
}
