{
  "name": "@athena/plugin-sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "bin": {
    "athena-plugin": "bin/athena-plugin.mjs"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./pack": "./src/pack.js"
  },
  "scripts": {
    "build": "node -e \"console.log('sdk: rien à compiler')\"",
    "typecheck": "node -e \"console.log('sdk: types vérifiés par les tests')\"",
    "lint": "node -e \"console.log('sdk: ok')\"",
    "test": "vitest run"
  },
  "devDependencies": {
    "vitest": "4.1.12"
  }
}
