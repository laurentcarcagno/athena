{
  "name": "@nuance/theming",
  "version": "0.1.0",
  "private": true,
  "description": "Moteur de thèmes générique : jetons au format W3C Design Tokens, modes, héritage, contrôle des contrastes, génération CSS.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "theming": "dist/bin.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "22.7.5",
    "typescript": "5.6.3",
    "vitest": "4.1.12"
  }
}
