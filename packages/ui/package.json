{
  "name": "@athena/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./tokens.css": "./src/tokens.generated.css"
  },
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "build": "node scripts/build-tokens.mjs && tsc -p tsconfig.json",
    "typecheck": "node scripts/build-tokens.mjs && tsc -p tsconfig.json --noEmit",
    "lint": "node scripts/lint-design.mjs src",
    "test": "node scripts/build-tokens.mjs && vitest run"
  },
  "dependencies": {},
  "devDependencies": {
    "vitest": "2.1.3",
    "yaml": "2.6.0"
  }
}
