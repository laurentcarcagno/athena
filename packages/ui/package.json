{
  "name": "@athena/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./src/tokens.generated.css",
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "build": "node scripts/build-tokens.mjs && tsc -p tsconfig.json",
    "typecheck": "node scripts/build-tokens.mjs && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "lint": "node scripts/lint-design.mjs src",
    "design:check": "node scripts/validate-design.mjs",
    "test": "node scripts/build-tokens.mjs && vitest run",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build -o storybook-static"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@storybook/react": "8.6.19",
    "@storybook/react-vite": "8.6.19",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.6.2",
    "@testing-library/react": "16.0.1",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "22.7.5",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.1",
    "jsdom": "25.0.1",
    "storybook": "8.6.19",
    "vite": "^6.4.5",
    "vitest": "4.1.12",
    "yaml": "2.6.0"
  }
}
