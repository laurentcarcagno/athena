{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "name": "base",
  "label": "Base",
  "meta": {
    "abstract": true,
    "description": "Jetons communs à tous les thèmes : typographie, espacements, épaisseurs, tailles, couches, mouvement, surcouches de la surface inverse. Les thèmes en héritent (extends) et fournissent couleurs, forme et marque."
  },
  "tokens": {
    "font": {
      "family": {
        "sans": {
          "$value": "IBM Plex Sans, system-ui, -apple-system, sans-serif",
          "$type": "fontFamily"
        },
        "mono": {
          "$value": "\"IBM Plex Mono\", ui-monospace, monospace",
          "$type": "fontFamily"
        }
      },
      "size": {
        "small": {
          "$value": "12px",
          "$type": "dimension"
        },
        "body": {
          "$value": "14px",
          "$type": "dimension"
        },
        "subsection": {
          "$value": "14px",
          "$type": "dimension"
        },
        "section": {
          "$value": "16px",
          "$type": "dimension"
        },
        "title": {
          "$value": "22px",
          "$type": "dimension"
        },
        "display": {
          "$value": "28px",
          "$type": "dimension"
        }
      },
      "weight": {
        "regular": {
          "$value": 400,
          "$type": "fontWeight"
        },
        "medium": {
          "$value": 500,
          "$type": "fontWeight"
        },
        "semibold": {
          "$value": 600,
          "$type": "fontWeight"
        },
