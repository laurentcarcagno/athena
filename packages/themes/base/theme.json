          "$type": "dimension"
        },
        "mono": {
          "$value": "0.02em",
          "$type": "dimension"
        }
      },
      "leading": {
        "none": {
          "$value": 1,
          "$type": "number"
        },
        "display": {
          "$value": 1.2,
          "$type": "number"
        },
        "title": {
          "$value": 1.25,
          "$type": "number"
        },
        "section": {
          "$value": 1.35,
          "$type": "number"
